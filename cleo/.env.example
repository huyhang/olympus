# Copy to .env and fill in. .env is gitignored; this template is not.
#
#     cp .env.example .env && chmod 600 .env
#
# Real environment variables override anything set here, so a container or a
# CI job can supply the token without a file.

# Where Nineveh answers. Locally this is the default; from elsewhere use the
# Tailscale name, which keeps the service off any routable address.
NINEVEH_URL=http://localhost:8080
# NINEVEH_URL=http://nineveh.your-tailnet.ts.net

# A librarian token from Nineveh's Admin -> Librarian page. Shown once at
# creation and stored there only as a hash: if it is lost, issue a new one
# rather than trying to recover it.
#
# This read-only iteration needs only catalog:read and metadata:read. Do not
# grant either ingest capability; Nineveh then independently enforces the same
# boundary as Cleo's fixed tool registry.
NINEVEH_TOKEN=

# Ollama stays local by default. CLEO_MODEL is explicit so a future model
# change is a reviewable configuration choice rather than a silent fallback.
OLLAMA_URL=http://localhost:11434
CLEO_MODEL=granite4.2:8b

# Optional. Defaults to ~/.local/share/cleo, whose directory and files Cleo
# restricts to the current operating-system account.
# CLEO_STATE_DIR=/path/to/private/cleo-state
